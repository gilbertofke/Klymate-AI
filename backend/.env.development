# Development Environment Configuration
DEBUG=True
LOG_LEVEL=DEBUG
ENVIRONMENT=development

# Database Configuration (Local PostgreSQL for development)
DATABASE_URL=postgresql+asyncpg://klymate:klymate_dev_password@localhost:5432/klymate_dev

# TiDB Configuration (Optional - can use local PostgreSQL)
TIDB_HOST=localhost
TIDB_PORT=5432
TIDB_USER=klymate
TIDB_PASSWORD=klymate_dev_password
TIDB_DATABASE=klymate_dev
TIDB_SSL_CA=
TIDB_SSL_VERIFY=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# API Keys (Development/Test keys)
OPENAI_API_KEY=sk-test-development-key-replace-with-real-key
FIREBASE_CREDENTIALS=./firebase-credentials-dev.json

# Security
JWT_SECRET_KEY=development-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# Cache Configuration
CACHE_TTL=300
CACHE_ENABLED=true

# Logging
LOG_FORMAT=detailed
LOG_FILE=logs/klymate-dev.log