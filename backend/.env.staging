# Staging Environment Configuration
ENVIRONMENT=staging
DEBUG=false

# Database Configuration
TIDB_HOST=${TIDB_STAGING_HOST}
TIDB_PORT=4000
TIDB_USER=${TIDB_STAGING_USER}
TIDB_PASSWORD=${TIDB_STAGING_PASSWORD}
TIDB_DATABASE=${TIDB_STAGING_DATABASE}
TIDB_SSL_CA=${TIDB_STAGING_SSL_CA}

# Redis Configuration
REDIS_URL=${REDIS_STAGING_URL}

# Firebase Configuration
FIREBASE_PROJECT_ID=${FIREBASE_STAGING_PROJECT_ID}
FIREBASE_PRIVATE_KEY_ID=${FIREBASE_STAGING_PRIVATE_KEY_ID}
FIREBASE_PRIVATE_KEY=${FIREBASE_STAGING_PRIVATE_KEY}
FIREBASE_CLIENT_EMAIL=${FIREBASE_STAGING_CLIENT_EMAIL}
FIREBASE_CLIENT_ID=${FIREBASE_STAGING_CLIENT_ID}
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_STAGING_API_KEY}

# JWT Configuration
JWT_SECRET_KEY=${JWT_STAGING_SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Klymate AI Backend - Staging
CORS_ORIGINS=["https://staging.klymate.ai", "http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Monitoring
SENTRY_DSN=${SENTRY_STAGING_DSN}
ENABLE_METRICS=true