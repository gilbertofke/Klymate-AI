[run]
source = app
omit = 
    */tests/*
    */test_*
    */conftest.py
    */migrations/*
    */alembic/*
    */__pycache__/*
    */venv/*
    */env/*
    */main.py
    */setup_*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
    except ImportError:
    except ModuleNotFoundError:

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
title = Klymate AI Backend Coverage Report

[xml]
output = coverage.xml

[json]
output = coverage.json
pretty_print = true