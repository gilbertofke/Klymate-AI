# Production Environment Configuration
ENVIRONMENT=production
DEBUG=false

# Database Configuration
TIDB_HOST=${TIDB_PRODUCTION_HOST}
TIDB_PORT=4000
TIDB_USER=${TIDB_PRODUCTION_USER}
TIDB_PASSWORD=${TIDB_PRODUCTION_PASSWORD}
TIDB_DATABASE=${TIDB_PRODUCTION_DATABASE}
TIDB_SSL_CA=${TIDB_PRODUCTION_SSL_CA}

# Redis Configuration
REDIS_URL=${REDIS_PRODUCTION_URL}

# Firebase Configuration
FIREBASE_PROJECT_ID=${FIREBASE_PRODUCTION_PROJECT_ID}
FIREBASE_PRIVATE_KEY_ID=${FIREBASE_PRODUCTION_PRIVATE_KEY_ID}
FIREBASE_PRIVATE_KEY=${FIREBASE_PRODUCTION_PRIVATE_KEY}
FIREBASE_CLIENT_EMAIL=${FIREBASE_PRODUCTION_CLIENT_EMAIL}
FIREBASE_CLIENT_ID=${FIREBASE_PRODUCTION_CLIENT_ID}
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# OpenAI Configuration
OPENAI_API_KEY=${OPENAI_PRODUCTION_API_KEY}

# JWT Configuration
JWT_SECRET_KEY=${JWT_PRODUCTION_SECRET_KEY}
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Klymate AI Backend
CORS_ORIGINS=["https://klymate.ai", "https://app.klymate.ai"]

# Logging
LOG_LEVEL=WARNING
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Monitoring
SENTRY_DSN=${SENTRY_PRODUCTION_DSN}
ENABLE_METRICS=true

# Performance
WORKERS=4
MAX_CONNECTIONS=100
KEEP_ALIVE=2